# ---- THE SWITCH: where every AI call goes ----
# Every slot below (text, docs, image, voice, dictation) uses these unless it sets its own
# AI_<SLOT>_BASE_URL / AI_<SLOT>_API_KEY. Change these two lines and documents, answers, images,
# the call and dictation all go to the new endpoint. The server prints where each capability
# sends its data on startup.
AI_BASE_URL=https://digitallabs-wireframe-b-resource.openai.azure.com/openai/v1
AI_API_KEY=9JyLa7UyWW7YfWx0uwtel8FL9X3UlH85oBVcn5vqKuyTLjtvofSTJQQJ99CIACHYHv6XJ3w3AAAAACOGHuQq
 
# Example: Mastercard Azure OpenAI
#   AI_BASE_URL=https://digitallabs-wireframe-b-resource.openai.azure.com/openai/v1
#   AI_API_KEY=9JyLa7UyWW7YfWx0uwtel8FL9X3UlH85oBVcn5vqKuyTLjtvofSTJQQJ99CIACHYHv6XJ3w3AAAAACOGHuQq
 
# ---- server ----
PORT=3000
HOST=127.0.0.1            # 0.0.0.0 to let other machines in (then set CONSOLE_TOKEN, and put HTTPS in front)
CONSOLE_TOKEN=
# DATA_DIR=./data
 
# ---- text: every option and question the client sees (fast, called often) ----
AI_TEXT_PROVIDER=openai   # openai (Responses API) | chat (any OpenAI-compatible /chat/completions)
AI_TEXT_MODEL=gpt-5.6-luna
# AI_TEXT_BASE_URL=        (defaults to AI_BASE_URL)
# AI_TEXT_API_KEY=         (defaults to AI_API_KEY)
AI_TEXT_REASONING=medium  # openai only: none | low | medium | high
 
# ---- docs: reading the client's documents, and writing the pack once it's sent ----
# One-off calls where quality beats speed. Same options as text. If it fails, the text slot takes over.
AI_DOCS_PROVIDER=openai
AI_DOCS_MODEL=gpt-5.6-terra
# AI_DOCS_BASE_URL=       (defaults to AI_BASE_URL)
# AI_DOCS_API_KEY=        (defaults to AI_API_KEY)
 
# ---- images: the concept boards and the story photo ----
AI_IMAGE_PROVIDER=openai  # openai | none (cards fall back to colour, no art)
AI_IMAGE_MODEL=gpt-image-2.5-flare
# AI_IMAGE_BASE_URL=       (defaults to AI_BASE_URL)
# AI_IMAGE_API_KEY=        (defaults to AI_API_KEY)
AI_IMAGE_QUALITY=low      # low (about 12s) | medium | high
 
# ---- voice: the "Talk it through" call ----
AI_VOICE_PROVIDER=openai-live   # openai-live | none (becomes a typed chat with the text model)
AI_VOICE_MODEL=gpt-live-1
# AI_VOICE_BASE_URL=       (defaults to AI_BASE_URL)
# AI_VOICE_API_KEY=        (defaults to AI_API_KEY)
AI_VOICE_VOICE=quartz     # quartz and ripple are Australian; also willow, stone, vesper, gleam, meridian…
 
# ---- dictation: the mic in "Write it down" ----
AI_TRANSCRIBE_PROVIDER=openai   # openai (any /audio/transcriptions endpoint) | none (mic button hidden)
AI_TRANSCRIBE_MODEL=gpt-transcribe
# AI_TRANSCRIBE_BASE_URL=       (defaults to AI_BASE_URL)
# AI_TRANSCRIBE_API_KEY=        (defaults to AI_API_KEY)