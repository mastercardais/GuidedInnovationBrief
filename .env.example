# Copy to .env and fill in. Never commit the real .env.
#
# Everything AI goes through AI_BASE_URL unless a slot overrides it with AI_<SLOT>_BASE_URL.
AI_BASE_URL=https://digitallabs-wireframe-b-resource.openai.azure.com/openai/v1
AI_API_KEY=

# Optional overrides (defaults shown by the server's startup log)
# AI_TEXT_MODEL=gpt-5.6-luna
# AI_DOCS_MODEL=gpt-5.6-terra
# AI_IMAGE_MODEL=gpt-image-2.5-flare
# AI_IMAGE_PROVIDER=openai
# AI_VOICE_MODEL=gpt-live-1
# AI_VOICE_PROVIDER=openai-live
# AI_TRANSCRIBE_MODEL=gpt-transcribe
# AI_TRANSCRIBE_PROVIDER=openai

# Server
# PORT=3000
# HOST=127.0.0.1
# DATA_DIR=./data
# CONSOLE_TOKEN=
